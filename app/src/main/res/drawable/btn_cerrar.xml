<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Fondo blanco -->
    <solid android:color="@color/white" />

    <!-- Borde rojo -->
    <stroke
        android:width="2dp"
        android:color="@color/color_rojo" />

    <!-- Tamaño mínimo (opcional, el botón respeta layout_width/height) -->
    <size
        android:width="40dp"
        android:height="40dp" />
</shape>
