<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="center_horizontal"
    android:layout_marginHorizontal="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/contenedorIzquierdo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:paddingVertical="3dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <TextView
                android:id="@+id/labelOfertaCantidad"
                android:layout_width="70dp"
                android:layout_height="25dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_descuento"
                android:gravity="center"
                android:padding="4dp"
                android:text="OFERTA"
                android:textColor="@color/color_rojo"
                android:textSize="13sp"
                android:textStyle="bold"
                android:elevation="8dp"
                android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/etPromociones"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_verde"
                android:elevation="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text=""
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_promociones"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="15dp"
                app:iconTint="@android:color/white"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/etFavoritos"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="5dp"
                android:backgroundTint="@color/color_rojo"
                android:elevation="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text=""
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_favoritos"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="15dp"
                app:iconTint="@android:color/white"
                app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorCentral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5">

            <TextView
                android:id="@+id/tvNombreArticulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del artículo"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginHorizontal="16dp"
                android:maxWidth="200dp"
                android:textColor="@color/black"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvPrecioArticulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S/ 0.00"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_precio_rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="10dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvOfertaValida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oferta válida hasta agotar stock"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/color_rojo"
                android:layout_marginTop="6dp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- Zona Derecha: botón cerrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrar"
            style="@style/Widget.MaterialComponents.Button.Icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:backgroundTint="@android:color/white"
            android:elevation="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text=""
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="15dp"
            app:iconTint="@color/color_rojo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/contenedorCentral"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/color_rojo"
            app:strokeWidth="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Campo Cantidad -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxBackgroundColor="@android:color/white"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="@color/color_principal"
        app:hintTextColor="@android:color/darker_gray"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botón Restar con ícono -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestar"
                style="@style/Widget.MaterialComponents.Button.Icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_principal"
                android:elevation="4dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:text=""
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_restar"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@android:color/white"
                app:strokeWidth="0dp" />

            <!-- Campo Cantidad -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCantidad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="numberDecimal"
                android:gravity="center"
                android:textCursorDrawable="@drawable/cursor_color"
                android:textColor="@android:color/black"
                android:hint="Cantidad(*)"
                android:textColorHint="@android:color/darker_gray"/>

            <!-- Botón Sumar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSumar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/color_principal"
                android:elevation="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text=""
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_add"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:strokeWidth="0dp"
                style="@style/Widget.MaterialComponents.Button.Icon" />
        </LinearLayout>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo Detalle -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="2dp"
        android:visibility="gone"
        app:boxBackgroundColor="@android:color/white"
        app:boxBackgroundMode="filled"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/color_principal"
        app:boxStrokeWidth="1dp"
        app:hintTextColor="@android:color/darker_gray">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Detalle"
            android:inputType="number"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/darker_gray"
            android:visibility="gone" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nota -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="(*) La cantidad puede variar de acuerdo al peso"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="@android:color/black"
        android:layout_marginBottom="20dp" />

    <!-- Botón Agregar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregar"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Agregar"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/color_principal"
        app:cornerRadius="50dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:layout_gravity="center_horizontal" />
</LinearLayout>
