<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:backgroundTint="@android:color/white"
    app:strokeColor="@color/color_principal"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Carrito"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:backgroundTint="@android:color/white"
                android:elevation="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text=""
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/color_rojo"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:strokeColor="@color/color_rojo"
                app:strokeWidth="2dp"
                style="@style/Widget.MaterialComponents.Button.Icon" />
        </LinearLayout>

        <!-- Lista de productos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="ifContentScrolls"
                android:padding="4dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_articulo_carrito" />
        </LinearLayout>

        <!-- Mensaje vacío -->
        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawableTop="@drawable/ic_carrito_compras"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:text="No hay productos en el carrito"
            android:textColor="@color/darker_gray"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Botón agregar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Agregar"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/color_verde"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@android:color/white"
            app:iconPadding="8dp"
            android:visibility="gone" />

        <!-- SECCIÓN DATOS DE PEDIDO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutDetallesCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_margin="8dp"
            android:background="@android:color/darker_gray"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dirección -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDireccion"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="📍 Ingrese su dirección"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/darker_gray"
                    app:hintTextColor="@color/darker_gray"
                    android:background="@android:color/transparent"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/black"
                        android:textCursorDrawable="@drawable/cursor_color" />
                </com.google.android.material.textfield.TextInputLayout>


                <!-- Medio de pago -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardview_productos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:layout_constraintTop_toBottomOf="@id/cardview_categorias"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <Spinner
                        android:id="@+id/spMedioPago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:padding="16dp" />
                </androidx.cardview.widget.CardView>

                <!-- Referencia de Pago -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReferenciaPago"
                    android:layout_marginTop="10dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="💶 Usted paga con"
                    app:boxStrokeColor="@color/darker_gray"
                    app:boxBackgroundColor="@color/white"
                    app:hintTextColor="@color/darker_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReferenciaPago"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Totales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total: S/ 0.00"
                        android:textColor="@color/color_principal"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMensajeTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="(Monto referencial, puede variar según el peso y cantidad)"
                        android:textColor="@color/darker_gray"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMinimoCompra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="El monto mínimo para realizar un pedido es de S/15.00"
                    android:textColor="@color/color_rojo"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Botón enviar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnviarPedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/color_verde"
                    android:text="Enviar Pedido"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="30dp"
                    app:icon="@drawable/ic_moto_pedido"
                    app:iconTint="@android:color/white"
                    app:iconPadding="12dp" />



            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
