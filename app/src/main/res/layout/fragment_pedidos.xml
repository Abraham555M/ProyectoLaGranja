<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_fondo"
    tools:context=".ui.Pedidos.PedidosFragment">

    <!-- CardView para el Spinner de Estado -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Spinner
            android:id="@+id/sp_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:padding="12dp"
            android:spinnerMode="dropdown"/>
    </androidx.cardview.widget.CardView>

    <!-- CardView para los Filtros de Fechas -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview_fechas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardview_estado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">

            <EditText
                android:id="@+id/et_fecha_ini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textCursorDrawable="@drawable/cursor_color"
                android:hint="Fecha Inicio"
                android:focusable="false"
                android:saveEnabled="false"
                android:clickable="true"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/et_fecha_fin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textCursorDrawable="@drawable/cursor_color"
                android:hint="Fecha Fin"
                android:saveEnabled="false"
                android:focusable="false"
                android:clickable="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView para mostrar los pedidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPedidos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnNuevoPedido"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardview_fechas"
        tools:listitem="@layout/item_pedido" />

    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardview_fechas"
        app:layout_constraintBottom_toTopOf="@id/btnNuevoPedido"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivEmptyIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_sin_articulos"
            app:tint="@color/darker_gray" />

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay registros disponibles"
            android:textColor="@color/darker_gray"
            android:textSize="16sp"
            android:layout_marginTop="12dp"
            android:gravity="center"/>
    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNuevoPedido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nuevo Pedido"
        android:layout_margin="16dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/color_principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
