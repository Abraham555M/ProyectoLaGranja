<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título o Mensaje -->
        <TextView
            android:id="@+id/tvMensajeCancelar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="¿Desea usted cambiar su número de teléfono?"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="?android:textColorPrimary"
            android:textAlignment="center"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/layoutBotones" />

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvMensajeCancelar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarSi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sí"
                app:cornerRadius="16dp"
                app:backgroundTint="@color/color_verde" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                app:cornerRadius="16dp"
                android:layout_marginStart="16dp"
                app:backgroundTint="@color/color_rojo"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
