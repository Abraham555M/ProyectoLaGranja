<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.ProyectoLaGranja.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_principal"
            app:popupTheme="@style/Theme.ProyectoLaGranja.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>

    <include layout="@layout/content_main" />

    <FrameLayout
    android:id="@+id/fabContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_margin="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="8dp">


<com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_carrito_compras"
            app:backgroundTint="@color/color_verde" />

        <!-- Badge declarado después para que quede encima -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|end"
            android:translationX="6dp"
            android:translationY="-6dp"
            android:gravity="center"
            android:background="@drawable/bg_badge"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            android:elevation="8dp"
            android:text="0"/>
    </FrameLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>